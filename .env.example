# ZK-OAuthChain -- configuration de deploiement
# Copiez ce fichier en .env et renseignez VOS valeurs. Ne versionnez jamais .env.

# Point d'acces RPC Sepolia (Alchemy, Infura, ou noeud public)
SEPOLIA_RPC_URL=

# Cle privee d'un compte de TEST uniquement, alimente par un faucet Sepolia.
# N'utilisez jamais ici une cle detenant des fonds reels.
DEPLOYER_PRIVATE_KEY=

# Adresse jouant le role de Serveur d'Autorisation (par defaut : le deployeur)
AS_ADDRESS=
